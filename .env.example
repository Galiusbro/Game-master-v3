# OpenAI — the only external key. Without it the app still runs:
# narration falls back to deterministic text instead of LLM output.
OPENAI_API_KEY=

# LLM model for narration/dialogue
MAIN_MODEL=gpt-4.1-nano

# Databases — docker/docker-compose.yml starts all four with these
# dev credentials. Never reuse them in production.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=gamemaster123
QDRANT_HOST=localhost
QDRANT_PORT=6333
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gamemaster
POSTGRES_USER=gm_user
POSTGRES_PASSWORD=gm_password
REDIS_HOST=localhost
REDIS_PORT=6379

# App
APP_ENVIRONMENT=development
APP_DEBUG=true
