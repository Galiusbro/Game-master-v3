# Narration runs on one LLM provider. Every supported one speaks the OpenAI
# protocol, so a single client and one set of prompts serve them all. Set any
# key — without one the app still runs and falls back to deterministic text.
OPENAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# auto = the first configured provider in priority order: gemini, nvidia,
# openai. Gemini leads on latency, which is what a turn of play lives on.
#
# Measured end to end on a real game command (full world context, not a toy
# prompt), seconds per command:
#   gemini-3.1-flash-lite               8-12    <- default, steadiest
#   nvidia/nemotron-3.5-lightning-30b   8-55    same quality, wide spread
#   nvidia/nemotron-3-super-120b        16-18   plus occasional 503
#   deepseek-ai/deepseek-v4-flash       ~19 and a 228s service warm-up
# Isolated calls are far faster for every model; the context assembly and
# the prompt size are most of a turn's cost, so compare these, not vendor
# benchmarks.
#
# All NVIDIA models need reasoning switched off or they queue for minutes;
# the app sends that flag automatically (see Settings._nvidia_extras).
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-3.1-flash-lite
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# LLM model for narration/dialogue. Only used for the OpenAI provider; the
# provider's own *_MODEL wins unless this names a model of that provider.
MAIN_MODEL=gpt-4.1-nano

# Databases — docker/docker-compose.yml starts all four with these
# dev credentials. Never reuse them in production.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=gamemaster123
QDRANT_HOST=localhost
QDRANT_PORT=6333
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gamemaster
POSTGRES_USER=gm_user
POSTGRES_PASSWORD=gm_password
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth. The secret signs bearer tokens: anyone holding it can mint one for
# any account, so the app refuses to start in production while it is still
# this default. Same for CORS_ORIGINS being open to every site.
JWT_SECRET_KEY=dev_secret_change_in_production
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=["*"]

# App
APP_ENVIRONMENT=development
APP_DEBUG=true
