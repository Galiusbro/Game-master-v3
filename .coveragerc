[run]
source = src
omit = 
    src/tests/*
    src/*/__init__.py
    */venv/*
    */migrations/*
    */site-packages/*
    src/main.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod

show_missing = True
skip_covered = False
precision = 2

[html]
directory = htmlcov
title = Game Master V3 Coverage Report